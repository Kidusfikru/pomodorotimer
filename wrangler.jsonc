{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "cutepomodorotimer",
	"compatibility_date": "2026-08-08",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"workers_dev": true,
	"preview_urls": true,
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	}
}
