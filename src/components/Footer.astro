---
import Mascot from './Mascot.astro';
import { t, DEFAULT_LANG, type LangCode } from '../lib/i18n';

const lang = (Astro.currentLocale ?? DEFAULT_LANG) as LangCode;
const year = new Date().getFullYear();
---

<footer class="relative z-10 border-t-2 border-[color-mix(in_srgb,var(--ink)_10%,transparent)]">
	<div class="mx-auto flex w-full max-w-3xl flex-col items-center gap-5 px-4 py-8 text-center sm:px-6">
		<div class="flex flex-col items-center gap-2">
			<span
				class="grid h-10 w-10 place-items-center rounded-full border-2 border-[color-mix(in_srgb,var(--tomato)_55%,transparent)] bg-[var(--tomato-soft)] shadow-[0_3px_0_color-mix(in_srgb,var(--tomato)_35%,transparent)]"
			>
				<Mascot class="h-8 w-full" />
			</span>
			<p class="text-base font-bold tracking-tight text-ink">
				<span data-i18n="brand.title">{t(lang, 'brand.title')}</span> <span class="text-[var(--tomato)]">♡</span>
			</p>
			<p class="text-xs leading-relaxed text-mute">A cozy little focus space, made especially for Abby.</p>
		</div>

		<div class="flex flex-col items-center gap-2 border-t border-[color-mix(in_srgb,var(--tomato)_24%,transparent)] pt-5">
			<p class="text-xs text-mute">
				© {year} Abby's Pomodoro. <span data-i18n="footer.rights">{t(lang, 'footer.rights')}</span>
			</p>
			<p class="flex items-center gap-1.5 text-xs text-mute">
				Made especially for Abby <span class="text-[var(--tomato)]">♡</span>
			</p>
		</div>
	</div>
</footer>
