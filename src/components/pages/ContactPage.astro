---
import PageLayout from "../../layouts/PageLayout.astro";
import { t, DEFAULT_LANG, type LangCode, type TranslationKey } from "../../lib/i18n";

const lang = (Astro.currentLocale ?? DEFAULT_LANG) as LangCode;
---

<PageLayout page="contact">
	<p class="eyebrow text-[var(--accent-ink)]" data-i18n="contact.eyebrow">
		{t(lang, "contact.eyebrow" as TranslationKey)}
	</p>
	<h1 class="mt-2 text-3xl font-extrabold leading-snug text-ink sm:text-4xl" data-i18n="contact.title">
		{t(lang, "contact.title" as TranslationKey)}
	</h1>
	<p class="mt-4 text-sm leading-relaxed text-body sm:text-base" data-i18n="contact.intro">
		{t(lang, "contact.intro" as TranslationKey)}
	</p>

	<div class="mt-8 flex flex-col items-start gap-4">
		<div class="flex flex-wrap items-center gap-3">
			<a
				href="mailto:hello@cutepomodorotimer.com"
				class="sticker-btn inline-flex items-center gap-2.5 px-6 py-3.5 text-sm sm:text-base font-bold"
				style="--btn-bg: var(--tomato-deep); --btn-ink: #fff; --btn-edge: color-mix(in srgb, var(--tomato-deep) 70%, #000)"
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<rect width="20" height="16" x="2" y="4" rx="2" />
					<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
				</svg>
				<span>hello@cutepomodorotimer.com</span>
			</a>

			<button
				type="button"
				id="copy-email-btn"
				class="icon-btn"
				data-i18n-aria="contact.copyEmail"
				aria-label={t(lang, "contact.copyEmail" as TranslationKey)}
				title={t(lang, "contact.copyEmail" as TranslationKey)}
				data-copied-label={t(lang, "contact.copied" as TranslationKey)}
				data-copy-label={t(lang, "contact.copyEmail" as TranslationKey)}
			>
				<svg id="copy-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
					<path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
				</svg>
				<svg id="check-icon" class="hidden text-[var(--sage)]" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<polyline points="20 6 9 17 4 12"/>
				</svg>
			</button>
		</div>

		<p class="text-xs leading-relaxed text-mute sm:text-sm" data-i18n="contact.directSuffix">
			{t(lang, "contact.directSuffix" as TranslationKey)}
		</p>
	</div>

	<script>
		const copyBtn = document.getElementById("copy-email-btn");
		const copyIcon = document.getElementById("copy-icon");
		const checkIcon = document.getElementById("check-icon");

		copyBtn?.addEventListener("click", async () => {
			try {
				if (navigator.clipboard && window.isSecureContext) {
					await navigator.clipboard.writeText("hello@cutepomodorotimer.com");
				} else {
					throw new Error("fallback");
				}
			} catch {
				const textArea = document.createElement("textarea");
				textArea.value = "hello@cutepomodorotimer.com";
				textArea.style.position = "fixed";
				textArea.style.opacity = "0";
				document.body.appendChild(textArea);
				textArea.focus();
				textArea.select();
				try {
					document.execCommand("copy");
				} catch {}
				document.body.removeChild(textArea);
			}
			copyIcon?.classList.add("hidden");
			checkIcon?.classList.remove("hidden");
			const copiedLabel = copyBtn?.dataset.copiedLabel;
			if (copyBtn && copiedLabel) {
				copyBtn.setAttribute("aria-label", copiedLabel);
				copyBtn.setAttribute("title", copiedLabel);
			}
			setTimeout(() => {
				copyIcon?.classList.remove("hidden");
				checkIcon?.classList.add("hidden");
				const copyLabel = copyBtn?.dataset.copyLabel;
				if (copyBtn && copyLabel) {
					copyBtn.setAttribute("aria-label", copyLabel);
					copyBtn.setAttribute("title", copyLabel);
				}
			}, 2000);
		});
	</script>
</PageLayout>
