---
import Layout from '../../layouts/Layout.astro';
import Background from '../../components/Background.astro';
import TopBar from '../../components/TopBar.astro';
import Timer from '../../components/Timer.astro';
import TodoPanel from '../../components/TodoPanel.astro';
import SettingsPanel from '../../components/SettingsPanel.astro';
import Dock from '../../components/Dock.astro';
import SpotifyPanel from '../../components/SpotifyPanel.astro';
import Footer from '../../components/Footer.astro';
import { t, DEFAULT_LANG, type LangCode } from '../../lib/i18n';

const lang = (Astro.currentLocale ?? DEFAULT_LANG) as LangCode;
---

<Layout
	title="Abby's Pomodoro — A Little Focus, A Lot of Encouragement"
	description="A cozy Pomodoro timer made just for Abby, with gentle music, a sweet little mascot, and room for everything she's working toward."
>
	<a
		href="#main"
		class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-surface focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-ink"
		data-i18n="page.skip"
		>{t(lang, 'page.skip')}</a
	>
	<Background />
	<TopBar />

	<main id="main" class="relative">
		<div class="flex min-h-dvh flex-col items-center justify-center px-4 pb-[calc(6rem+env(safe-area-inset-bottom))] pt-[calc(4.5rem+env(safe-area-inset-top))] [justify-content:safe_center] [@media(min-height:920px)]:pb-[calc(7.5rem+env(safe-area-inset-bottom))] [@media(min-height:920px)]:pt-[calc(5.5rem+env(safe-area-inset-top))] [@media(max-height:720px)]:pb-[calc(5.5rem+env(safe-area-inset-bottom))] [@media(max-height:720px)]:pt-[calc(3.5rem+env(safe-area-inset-top))] [@media(max-height:520px)]:pb-[calc(4.75rem+env(safe-area-inset-bottom))] [@media(max-height:520px)]:pt-[calc(2.5rem+env(safe-area-inset-top))]">
			<h1 class="sr-only">Abby's Pomodoro — made just for Abby</h1>
			<p class="mb-1 inline-flex items-center gap-2 rounded-full border border-[color-mix(in_srgb,var(--tomato)_28%,transparent)] bg-[color-mix(in_srgb,var(--surface)_82%,transparent)] px-4 py-2 text-sm font-bold text-[var(--accent-ink)] shadow-sm [@media(max-height:520px)]:hidden">
				Made just for you, Abby <span aria-hidden="true" class="text-[var(--tomato)]">♡</span>
			</p>
			<Timer />
			<p class="mt-4 hidden text-xs text-mute/80 sm:mt-5 md:block [@media(max-height:720px)]:mt-2.5 [@media(max-height:520px)]:hidden">
				<span class="font-semibold">space</span> <span data-i18n="page.hintStart">{t(lang, 'page.hintStart')}</span>
				&middot; <span class="font-semibold">r</span> <span data-i18n="page.hintReset">{t(lang, 'page.hintReset')}</span>
				&middot; <span class="font-semibold">m</span> <span data-i18n="page.hintMusic">{t(lang, 'page.hintMusic')}</span>
				&middot; <span class="font-semibold">d</span> <span data-theme-shortcut-label>{t(lang, 'shortcut.light')}</span>
				&middot; <span class="font-semibold">f</span> <span data-i18n="page.hintFullscreen">{t(lang, 'page.hintFullscreen')}</span>
				<span class="text-[var(--accent)]">♡</span>
			</p>
		</div>
	</main>

	<Footer />

	<TodoPanel />
	<SettingsPanel />
	<SpotifyPanel />
	<Dock />

	<audio data-chime preload="none" tabindex="-1" aria-hidden="true">
		<source src="/sounds/zen-tone.mp3" type="audio/mpeg" />
		<source src="/sounds/zen-tone.m4a" type="audio/mp4" />
	</audio>

	<script>
		import '../../lib/app.ts';
	</script>
</Layout>

<style>
	/* Top/bottom clearance for the fixed TopBar and Dock now lives on the
	   timer's flex column itself (see class list above), so justify-center
	   centers inside the truly visible area and never tucks content behind
	   the dock. */
</style>
